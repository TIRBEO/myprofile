# Profile service — copy to .env.local
#
# The main API is the brain; this service reads around it. Envs fall into
# three groups: the HTTP line (always required), the direct Redis vein, and
# the direct database vein. Both veins are optional — without them reads
# simply fall through to the main server, exactly as before.

# ── The HTTP line (required) ─────────────────────────────────────────

# The main API as reachable from THIS server. Loopback is expected in
# development — this is a server-to-server address, not the address a browser
# uses, and it is never taken from a request.
API_INTERNAL_BASE_URL=http://localhost:3000

# Shared secret with the main API. Must equal INTERNAL_API_SECRET over there.
# Copy the value from apps/api/.env.local.
INTERNAL_API_SECRET=

# The account service's JWT signing key. Needed because this app verifies a
# bearer token itself instead of asking the main server who the caller is.
# Copy the value from apps/api/.env.local.
#
# There is deliberately no JWT_ISSUER here: the main API's signToken() does not
# put an `iss` claim in its tokens, so checking one would reject every real
# token this app is handed.
JWT_SECRET=

# ── The Redis vein (optional, recommended) ──────────────────────────

# The main API's Redis. Its session registry (`auth:session:<sid>`) and
# session-identity cache (`session:cache:<sid>`) are read directly from here,
# so answering "whose session is this" costs one round trip instead of one
# HTTP hop. Never written to. Copy REDIS_URL from apps/api/.env.local.
REDIS_URL=

# ── The database vein (optional, recommended) ───────────────────────

# The same Postgres the main API uses. Used for the profile read of last
# resort (after this process's cache and Redis), read-only — every write
# still goes through the main server so its audit trail stays intact.
# Copy DATABASE_URL from apps/api/.env.local.
DATABASE_URL=

# Cap on this process's share of the database connection pool. The main
# server keeps 8–12; this one needs only the read path.
PROFILE_DB_POOL_MAX=3

# ── Tuning ──────────────────────────────────────────────────────────

# How long a profile read stays cached in this process's memory, and how
# long to wait for the main API before giving up. Keep the window short: a
# profile is the thing the user just edited.
PROFILE_CACHE_TTL_MS=15000
PROFILE_TIMEOUT_MS=10000

# Browser-side only: where a signed-out reader is sent.
NEXT_PUBLIC_ACCOUNTS_URL=

# Mapbox GL publishable token (browser-safe). Unset -> the map falls back to the
# keyless OpenStreetMap embed. Keep the real value in .env.local, never in code.
NEXT_PUBLIC_MAPBOX_TOKEN=
